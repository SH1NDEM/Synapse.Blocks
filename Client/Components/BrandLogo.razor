@* Логотип Синапса: чип-ромб, к которому подходят провод порядка (белый) и провод данных (синий).
   Тот же знак, что на иконке сайта. *@
<span class="@($"brand-logo {(Compact ? "compact" : "")}")">
    <svg class="brand-symbol" viewBox="0 0 64 64" aria-hidden="true">
        <rect x="2" y="2" width="60" height="60" rx="16" class="brand-tile" />
        <path d="M7 32 H19" class="brand-wire exec" />
        <path d="M45 32 H57" class="brand-wire data" />
        <rect x="21.5" y="21.5" width="21" height="21" rx="3.5" transform="rotate(45 32 32)" class="brand-chip" />
        <circle cx="32" cy="32" r="4.4" class="brand-core" />
        <circle cx="7" cy="32" r="2.6" class="brand-spark" />
    </svg>
    @if (!Compact)
    {
        <span class="brand-word"><b>СИНАПС</b><small>ГОРОД БЛОКОВ</small></span>
    }
</span>

@code {
    /// <summary>Только знак, без названия.</summary>
    [Parameter] public bool Compact { get; set; }
}
