@using Synapse.Blocks.Graph
@* Палитра: вкладки по разделам (каждый раздел — свой цвет) и настоящие уменьшенные чипы.
   Чип можно перетащить на поле или добавить щелчком. Если передан Variables — появляется вкладка переменных. *@

<div class="palette-tabs" role="tablist" aria-label="Разделы блоков">
    <button type="button" role="tab" class="palette-tab tab-all @(ActiveTab == AllTab ? "active" : "")" aria-selected="@(ActiveTab == AllTab)" @onclick="() => _tab = AllTab">
        Все
    </button>
    @foreach (var category in Categories)
    {
        var key = category;
        <button type="button" role="tab" class="palette-tab cat-@key @(ActiveTab == key ? "active" : "")" aria-selected="@(ActiveTab == key)" @onclick="() => _tab = key">
            <i aria-hidden="true"></i><span>@NodeCategories.Label(key)</span>
        </button>
    }
    @if (Variables is not null)
    {
        <button type="button" role="tab" class="palette-tab cat-memory tab-variables @(ActiveTab == VariablesTab ? "active" : "")" aria-selected="@(ActiveTab == VariablesTab)" @onclick="() => _tab = VariablesTab">
            <i aria-hidden="true"></i><span>Переменные</span>@if (VariableCount > 0) { <b>@VariableCount</b> }
        </button>
    }
</div>

<div class="block-library node-palette @CssClass" role="tabpanel">
    @if (ActiveTab == VariablesTab && Variables is not null)
    {
        @Variables
    }
    else
    {
        if (ActiveTab == NodeCategories.Custom && CustomHeader is not null)
        {
            @CustomHeader
        }
        foreach (var group in Nodes.Where(node => ActiveTab == AllTab || node.Category == ActiveTab).GroupBy(node => node.Category))
        {
            <section class="palette-group cat-@group.Key">
                @if (ActiveTab == AllTab)
                {
                    <h3><i aria-hidden="true"></i>@NodeCategories.Label(group.Key)</h3>
                }
                @foreach (var definition in group)
                {
                    var item = definition;
                    var layout = NodeLayout.For(item);
                    <div class="palette-chip"
                         draggable="true"
                         title="@item.Label — @item.Description Перетащите на поле или нажмите, чтобы добавить."
                         @ondragstart="() => OnDragStart.InvokeAsync(item)"
                         @onclick="() => OnAdd.InvokeAsync(item)">
                        <div class="palette-chip-stage" style="width:@NodeLayout.Px(StageWidth * Scale);height:@NodeLayout.Px((layout.Height + 4) * Scale)">
                            <div class="palette-chip-scale" style="width:@NodeLayout.Px(StageWidth);height:@NodeLayout.Px(layout.Height + 4);transform:scale(@NodeLayout.Num(Scale))">
                                <GraphNodeView Node="_sample" Definition="item" Preview="true" Style="@($"left:{NodeLayout.Px(NodeLayout.PortReach)};top:2px")" />
                            </div>
                        </div>
                        <b class="palette-help" role="button" tabindex="0" aria-label="Справка: @item.Label"
                           @onclick="() => OnHelp.InvokeAsync(item)" @onclick:stopPropagation="true">?</b>
                    </div>
                }
            </section>
        }
    }
</div>

@code {
    private const string AllTab = "all";
    private const string VariablesTab = "variables";
    // Чипы в палитре — в натуральную величину: такие же, как на поле.
    private const double Scale = 1;
    private const double StageWidth = NodeLayout.Width + 2 * NodeLayout.PortReach;

    // Миниатюры только показывают блок и ничего не меняют, поэтому им хватает одного пустого экземпляра.
    private readonly GraphNode _sample = new();
    private string _tab = AllTab;

    [Parameter, EditorRequired] public IEnumerable<NodeDefinition> Nodes { get; set; } = [];
    [Parameter] public string CssClass { get; set; } = "";
    /// <summary>Содержимое вкладки «Переменные»; без него вкладка не показывается.</summary>
    [Parameter] public RenderFragment? Variables { get; set; }
    [Parameter] public int VariableCount { get; set; }
    /// <summary>Шапка вкладки «Мои блоки» (создание блока, библиотека); с ней вкладка видна, даже если блоков ещё нет.</summary>
    [Parameter] public RenderFragment? CustomHeader { get; set; }
    [Parameter] public EventCallback<NodeDefinition> OnAdd { get; set; }
    [Parameter] public EventCallback<NodeDefinition> OnDragStart { get; set; }
    [Parameter] public EventCallback<NodeDefinition> OnHelp { get; set; }

    // ───────────── Перерисовка только при изменениях ─────────────
    // Страница перерисовывается часто (анимация запуска), а палитра с миниатюрами чипов — дорогая.
    // Вкладки «Переменные» и «Мои блоки» показывают живые данные страницы и перерисовываются всегда,
    // остальные — только когда изменился набор блоков.

    private string _parameterKey = "";
    private bool _parametersRender;
    private bool _parametersChanged = true;

    protected override void OnParametersSet()
    {
        _parametersRender = true;
        var key = string.Join('|', Nodes.Select(node => $"{node.TypeId}:{node.Label}:{node.Ports.Count}"))
                  + $"#{VariableCount}#{Variables is null}#{CustomHeader is null}#{CssClass}";
        _parametersChanged = key != _parameterKey || ActiveTab is VariablesTab or NodeCategories.Custom;
        _parameterKey = key;
    }

    protected override bool ShouldRender()
    {
        if (!_parametersRender) return true;
        _parametersRender = false;
        return _parametersChanged;
    }

    private IEnumerable<string> Categories
    {
        get
        {
            var categories = Nodes.Select(node => node.Category).Where(category => category != NodeCategories.Custom).Distinct().ToList();
            // «Мои блоки» — всегда последней вкладкой.
            if (CustomHeader is not null || Nodes.Any(node => node.Category == NodeCategories.Custom))
                categories.Add(NodeCategories.Custom);
            return categories;
        }
    }

    /// <summary>Выбранная вкладка; если в новом уровне такого раздела нет, показываются все блоки.</summary>
    private string ActiveTab => _tab switch
    {
        AllTab => AllTab,
        VariablesTab when Variables is not null => VariablesTab,
        var category when Categories.Contains(category) => category,
        _ => AllTab
    };
}
