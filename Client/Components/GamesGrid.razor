        <g class="art-train"><rect x="58" y="19" width="14" height="10" rx="3" /><rect x="74" y="19" width="14" height="10" rx="2" /><rect x="90" y="19" width="14" height="10" rx="2" /></g>
        <g class="art-train art-freight"><rect x="66" y="60" width="14" height="10" rx="3" /><rect x="82" y="60" width="14" height="10" rx="2" /></g>
    </svg>;

