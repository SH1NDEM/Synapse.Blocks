    private static RenderFragment GamedevArt => @<svg viewBox="0 0 160 90">
        <rect class="d-soft" x="10" y="66" width="140" height="10" rx="5" /><rect class="d-soft" x="96" y="44" width="40" height="8" rx="4" />
        <rect class="d-main" x="40" y="42" width="20" height="24" rx="6" /><circle class="d-light" cx="54" cy="50" r="2.5" />
        <circle class="d-accent" cx="106" cy="30" r="5" /><circle class="d-accent" cx="122" cy="30" r="5" />
        <path class="d-line" d="M62 40 Q80 18 100 34" />
    </svg>;

    private static RenderFragment DataArt => @<svg viewBox="0 0 160 90">
        <rect class="d-soft" x="22" y="56" width="16" height="22" rx="3" /><rect class="d-main" x="46" y="40" width="16" height="38" rx="3" />
        <rect class="d-soft" x="70" y="48" width="16" height="30" rx="3" /><rect class="d-main" x="94" y="24" width="16" height="54" rx="3" />
        <rect class="d-accent" x="118" y="14" width="16" height="64" rx="3" />
        <path class="d-line" d="M22 50 L54 34 L78 42 L102 18 L126 8" />
