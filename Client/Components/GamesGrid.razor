    </svg>;

    private static RenderFragment SecurityArt => @<svg viewBox="0 0 160 90">
        <rect class="art-sender" x="14" y="16" width="16" height="11" rx="2" /><rect class="art-sender" x="14" y="40" width="16" height="11" rx="2" /><rect class="art-sender" x="14" y="64" width="16" height="11" rx="2" />
        <rect class="art-wall" x="72" y="10" width="14" height="28" rx="3" /><rect class="art-wall" x="72" y="54" width="14" height="28" rx="3" />
        <rect class="art-server" x="114" y="18" width="34" height="14" rx="3" /><rect class="art-server" x="114" y="38" width="34" height="14" rx="3" /><rect class="art-server" x="114" y="58" width="34" height="14" rx="3" />
        <rect class="art-ok" x="94" y="40" width="12" height="9" rx="2" /><rect class="art-bad" x="52" y="62" width="12" height="9" rx="2" />
