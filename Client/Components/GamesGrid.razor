        <path class="d-line" d="M80 26 V14" /><circle class="d-accent" cx="80" cy="11" r="4" />
        <circle class="d-soft" cx="64" cy="72" r="7" /><circle class="d-soft" cx="96" cy="72" r="7" />
    </svg>;

    private static RenderFragment WebArt => @<svg viewBox="0 0 160 90">
        <rect class="d-frame" x="24" y="10" width="112" height="70" rx="8" /><rect class="d-soft" x="24" y="10" width="112" height="14" rx="8" />
        <circle class="d-accent" cx="34" cy="17" r="2.5" /><circle class="d-light2" cx="42" cy="17" r="2.5" />
        <rect class="d-soft" x="36" y="34" width="60" height="9" rx="4" /><rect class="d-soft" x="36" y="49" width="88" height="9" rx="4" />
        <rect class="d-main" x="36" y="64" width="38" height="10" rx="5" />
    </svg>;
}
