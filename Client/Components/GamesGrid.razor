@using Synapse.Blocks.Games.Station
@using Synapse.Blocks.Games.Network
@using Synapse.Blocks.Games.Security
@using Synapse.Blocks.Games.Robots
@using Synapse.Blocks.Games.WebDev
@* Игры по направлениям: каждая карточка — сфера программирования и профессия.
   Где игры ещё нет, стоит плашка «Скоро». *@

<div class="games-grid directions-grid">
    @foreach (var direction in Directions)
    {
        var done = direction.Levels.Count(Completed.Contains);
        var ready = direction.Url is not null;
        var locked = ready && Locked;
        <a class="@($"direction-card dir-{direction.Key} {(ready ? "" : "soon")} {(locked ? "locked" : "")}")" href="@(direction.Url ?? "games")" aria-disabled="@(!ready)">
            <div class="direction-art" aria-hidden="true">@direction.Art</div>
            <div class="direction-copy">
                <small>@direction.Name</small>
                <h3>@direction.Profession</h3>
                <p>@direction.About</p>
            </div>
            <footer>
                @if (!ready)
                {
                    <span class="direction-soon">Игра скоро</span>
                }
                else if (locked)
                {
                    <span class="direction-lock"><LockIcon Size="14" />После обучения · @(Training?.Done ?? 0) из @(Training?.Total ?? 0)</span>
                }
                else
                {
                    <span class="direction-game">@direction.Game</span>
                    <span class="direction-progress"><b>@done</b> / @direction.Levels.Count</span>
                    <b class="direction-go">Играть →</b>
                }
            </footer>
        </a>
    }
</div>

@code {
    [Parameter] public IReadOnlySet<Guid> Completed { get; set; } = new HashSet<Guid>();

    /// <summary>Статус обучения. Пока оно не пройдено, готовые игры закрыты.</summary>
    [Parameter] public TrainingStatus? Training { get; set; }

    private bool Locked => Training is { Unlocked: false };

    private sealed record Direction(string Key, string Name, string Profession, string About, string? Game, string? Url, IReadOnlyList<Guid> Levels, RenderFragment Art);

    private static readonly IReadOnlyList<Direction> Directions =
    [
        new("transport", "Транспорт и автоматизация", "Инженер систем управления",
            "Пишет программы, которые ведут поезда, переключают стрелки и управляют заводами.",
            "Станция Синапс", "games/station", StationLevels.All.Select(level => level.Id).ToList(), StationArt),
        new("network", "Сети", "Сетевой инженер",
            "Строит сети между районами и следит, чтобы данные доходили, куда нужно.",
            "Связь Синапса", "games/network", NetworkLevels.All.Select(level => level.Id).ToList(), NetworkArt),
        new("security", "Кибербезопасность", "Специалист по защите",
            "Защищает серверы и данные: пропускает жителей и отбивает взломщиков.",
            "Защита серверов", "games/security", SecurityLevels.All.Select(level => level.Id).ToList(), SecurityArt),
        new("gamedev", "Геймдев", "Разработчик игр",
            "Придумывает правила игры: как двигается герой, когда даются очки и как победить.",
            null, null, [], GamedevArt),
        new("data", "Данные и аналитика", "Аналитик данных",
            "Ищет ответы в числах: сколько жителей, когда пробки, что изменилось за неделю.",
            null, null, [], DataArt),
        new("robots", "Роботы и устройства", "Инженер-робототехник",
            "Программирует роботов, датчики и умные устройства — от светофора до курьера.",
            "Робот-курьер", "games/robots", RobotLevels.All.Select(level => level.Id).ToList(), RobotsArt),
        new("web", "Веб и приложения", "Веб-разработчик",
            "Делает сайты и приложения: кнопки, формы и проверку того, что ввёл человек.",
            "Форма регистрации", "games/web", WebLevels.All.Select(level => level.Id).ToList(), WebArt),
    ];

    private static RenderFragment StationArt => @<svg viewBox="0 0 160 90">
