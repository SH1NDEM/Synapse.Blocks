@using Synapse.Blocks.Games.Robots
@* Поле робота-курьера сверху: клетки, стены, метки, батарейки и сам робот.
   Каждый такт робот сначала поворачивается, потом едет на клетку; над ним видна команда. *@

<div class="robot-view">
    <svg viewBox="@($"-10 -10 {Level.Width * Cell + 20} {Level.Height * Cell + 20}")" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Поле робота">
        @{ var visited = Visited; var collected = Collected; }
        @for (var y = 0; y < Level.Height; y++)
        {
            for (var x = 0; x < Level.Width; x++)
            {
                var cell = Level.Cell(x, y);
                if (cell == '#')
                {
                    <rect class="rb-wall" x="@(x * Cell + 1)" y="@(y * Cell + 1)" width="@(Cell - 2)" height="@(Cell - 2)" rx="6" />
                    continue;
                }
                <rect class="@($"rb-floor {(visited.Contains((x, y)) ? "visited" : "")}")" x="@(x * Cell + 1)" y="@(y * Cell + 1)" width="@(Cell - 2)" height="@(Cell - 2)" rx="6" />
                if (cell == 'R')
                {
                    <path class="rb-mark red" d="@Arrow(x, y, 1)" />
                }
                else if (cell == 'B')
                {
                    <path class="rb-mark blue" d="@Arrow(x, y, -1)" />
                }
                else if (cell == 'F')
                {
                    <rect class="rb-finish" x="@(x * Cell + 6)" y="@(y * Cell + 6)" width="@(Cell - 12)" height="@(Cell - 12)" rx="5" />
                    <path class="rb-flag" d="@($"M {x * Cell + 15} {y * Cell + 30} V {y * Cell + 10} l 12 5 l -12 5")" />
                }
                else if (cell == 'S')
                {
                    <circle class="rb-start" cx="@(x * Cell + Cell / 2)" cy="@(y * Cell + Cell / 2)" r="5" />
                }
                if (cell == '*' && !collected.Contains((x, y)))
                {
                    <g class="rb-battery" transform="@($"translate({x * Cell + Cell / 2} {y * Cell + Cell / 2})")">
                        <rect x="-6" y="-10" width="12" height="20" rx="3" /><rect class="cap" x="-3" y="-13" width="6" height="3" rx="1" /><path d="M 1 -6 l -4 6 h 4 l -2 6" />
                    </g>
                }
            }
        }

        @{ var pose = Pose(); }
        <g class="@($"rb-robot {pose.Css}")" transform="@($"translate({N(pose.X)} {N(pose.Y)}) rotate({N(pose.Angle)})")">
            <rect class="rb-wheel" x="-15" y="-11" width="5" height="22" rx="2" />
            <rect class="rb-wheel" x="10" y="-11" width="5" height="22" rx="2" />
            <rect class="rb-body" x="-11" y="-13" width="22" height="26" rx="7" />
            <path class="rb-nose" d="M -6 -7 L 0 -13 L 6 -7 Z" />
            <circle class="rb-eye" cx="0" cy="1" r="4" />
        </g>
        @if (pose.Command.Length > 0)
        {
            <g class="@($"rb-bubble {pose.Css}")" transform="@($"translate({N(pose.X)} {N(pose.Y - 30)})")">
                <rect x="@N(-BubbleWidth(pose.Command) / 2)" y="-11" width="@N(BubbleWidth(pose.Command))" height="20" rx="10" />
                @SvgText("rb-bubble-text", 0, 3, pose.Command)
            </g>
        }
    </svg>
    <div class="station-clock"><span>@($"{(int)Time / 60:00}:{(int)Time % 60:00}")</span>@if (Status.Length > 0) { <b>@Status</b> }</div>
</div>

@code {
    private const int Cell = 40;

    [Parameter, EditorRequired] public RobotLevel Level { get; set; } = default!;
    [Parameter] public RobotRun? Run { get; set; }
    [Parameter] public double Time { get; set; }
    [Parameter] public string Status { get; set; } = "";

    private sealed record RobotPose(double X, double Y, double Angle, string Command, string Css);

    private static string N(double value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static MarkupString SvgText(string css, double x, double y, string content, string anchor = "middle")
        => new($"<text class=\"{css}\" x=\"{N(x)}\" y=\"{N(y)}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(content)}</text>");

    private static double BubbleWidth(string text) => 22 + text.Length * 7.5;

    /// <summary>Стрелка-метка на полу: 1 — поворот направо, −1 — налево.</summary>
    private static string Arrow(int x, int y, int turn)
    {
        var cx = x * Cell + Cell / 2.0;
        var cy = y * Cell + Cell / 2.0;
        return turn > 0
            ? $"M {N(cx - 9)} {N(cy + 9)} V {N(cy - 3)} H {N(cx + 4)} V {N(cy - 9)} L {N(cx + 11)} {N(cy - 1)} L {N(cx + 4)} {N(cy + 7)} V {N(cy + 1)} H {N(cx - 5)} V {N(cy + 9)} Z"
            : $"M {N(cx + 9)} {N(cy + 9)} V {N(cy - 3)} H {N(cx - 4)} V {N(cy - 9)} L {N(cx - 11)} {N(cy - 1)} L {N(cx - 4)} {N(cy + 7)} V {N(cy + 1)} H {N(cx + 5)} V {N(cy + 9)} Z";
    }

    private IEnumerable<RobotStep> Done => Run?.Steps.Where(step => Time >= step.End) ?? [];

    private HashSet<(int X, int Y)> Collected => Done.Where(step => step.Command == "взять" && step.Error.Length == 0).Select(step => (step.X, step.Y)).ToHashSet();

    private HashSet<(int X, int Y)> Visited
    {
        get
        {
            var cells = new HashSet<(int X, int Y)>();
            if (Run is null) return cells;
            foreach (var step in Run.Steps.Where(step => Time >= step.Start))
                cells.Add((step.X, step.Y));
            return cells;
        }
    }

    private static double Ease(double t) => t * t * (3 - 2 * t);

    private static double Center(int cell) => cell * Cell + Cell / 2.0;

    /// <summary>Где сейчас робот: поворот в первой трети такта, затем шаг на соседнюю клетку.</summary>
    private RobotPose Pose()
    {
        var (sx, sy) = Level.Start;
        if (Run is null || Run.Steps.Count == 0)
            return new RobotPose(Center(sx), Center(sy), Level.StartDirection * 90, "", "");

        var step = Run.Steps.LastOrDefault(item => Time >= item.Start) ?? Run.Steps[0];
        var t = Math.Clamp((Time - step.Start) / RobotSimulator.StepTime, 0, 1);
        var css = step.Error.Length > 0 ? "error" : step.Command == "стоп" ? "stop" : "";
        var from = step.Direction * 90.0;
        var turned = RobotSimulator.Turned(step.Direction, step.Command);
        var delta = step.Command switch { "налево" => -90.0, "направо" => 90.0, "назад" => 180.0, _ => 0.0 };
        var angle = from + delta * Ease(Math.Clamp(t / .35, 0, 1));
        var (x, y) = (Center(step.X), Center(step.Y));

        if (step.Command is "вперёд" or "налево" or "направо" or "назад")
        {
            var (nx, ny) = RobotSimulator.Ahead(step.X, step.Y, turned);
            var move = Ease(Math.Clamp((t - .35) / .65, 0, 1));
            // Удар о стену: робот доезжает до середины и отскакивает.
            if (step.Error.Length > 0)
                move = .45 * Math.Sin(Math.Clamp((t - .35) / .65, 0, 1) * Math.PI);
            x += (Center(nx) - x) * move;
            y += (Center(ny) - y) * move;
        }
        return new RobotPose(x, y, angle, step.Command, css);
    }
}
