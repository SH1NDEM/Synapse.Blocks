@page "/guide"
@using Synapse.Blocks.Graph
@inject NodeRegistry Registry

<PageTitle>Справка — Синапс</PageTitle>

@* Справка в общем виде главных страниц: зелёная полоса сверху, ниже светлые карточки. *@
<div class="home-top">
    <i class="home-blob one"></i><i class="home-blob two"></i>
    <section class="home-hero guide-top">
        <div class="home-hero-text">
            <span class="home-tag">Справка</span>
            <h1>Как устроены блоки — <em>коротко и понятно</em></h1>
            <p>Блоки не привязаны к заданию. Уровень говорит, что приходит на вход и что нужно вернуть, а как собрать схему — решаешь ты.</p>
            <div class="home-actions">
                <a class="home-button" href="game">К уровням</a>
            </div>
        </div>
        <ol class="guide-steps" aria-label="Как решать задание">
            <li><span>1</span><div><b>Прочитай задание</b><small>Что приходит на вход и что вернуть.</small></div></li>
            <li><span>2</span><div><b>Собери схему</b><small>Белый провод — порядок, цветные — данные.</small></div></li>
            <li><span>3</span><div><b>Запусти тесты</b><small>Посмотри, где ответ разошёлся, и поправь.</small></div></li>
        </ol>
    </section>
</div>

<div class="home guide-home">
    <section class="home-section">
        <header class="home-head">
            <h2><i class="home-icon blue">@Icon("wire")</i>Два вида проводов</h2>
            <p>Белый — порядок действий, цветные — данные.</p>
        </header>
        <div class="guide-wire-grid">
            <article><i class="guide-wire wire-exec-sample"></i><b>Порядок</b><small>Блок выполняется, когда до него доходит белый провод.</small></article>
            <article class="dt-number"><i class="guide-wire"></i><b>Число</b><small>5, −2, 3.14</small></article>
            <article class="dt-text"><i class="guide-wire"></i><b>Текст</b><small>«привет», «ERROR»</small></article>
            <article class="dt-bool"><i class="guide-wire"></i><b>Да / нет</b><small>Для условий и циклов «пока».</small></article>
            <article class="dt-list"><i class="guide-wire"></i><b>Список</b><small>[1, 2, 3] — для перебора.</small></article>
            <article class="dt-any"><i class="guide-wire"></i><b>Любое</b><small>Разъём примет значение любого типа.</small></article>
        </div>
        <p class="guide-tip"><b>Совет.</b> Пустой вход можно заполнить прямо в блоке: у «Арифметики» <code>a</code> приходит по проводу, а в <code>b</code> вписано число 2.</p>
    </section>

    @foreach (var group in Registry.All.GroupBy(definition => definition.Category))
    {
        <section class="home-section">
            <header class="home-head">
                <h2><i class="@($"guide-cat-dot cat-{group.Key}")"></i>@NodeCategories.Label(group.Key)</h2>
            </header>
            <div class="guide-blocks">
                @foreach (var definition in group)
                {
                    <article class="@($"guide-block {GraphStyle.AccentClass(definition)}")">
                        <header><b>@definition.Label</b><small>@(definition.IsPure ? "данные" : "действие")</small></header>
                        <p>@definition.Description</p>
                        <div class="guide-block-ports">
                            @foreach (var port in definition.Ports)
                            {
                                <span class="@($"guide-chip-port {(port.IsExec ? "exec" : GraphStyle.TypeClass(port.Type))}")">@(port.IsInput ? "→ " : "")@(port.IsExec ? (port.Label.Length > 0 ? port.Label : "порядок") : port.DisplayName)@(port.IsOutput ? " →" : "")</span>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="home-section">
        <div class="guide-check">
            <div>
                <h2><i class="home-icon purple">@Icon("check")</i>Как работает проверка</h2>
                <p>Схема запускается отдельно на каждом тесте: «Вход» получает новое значение, «Выход» возвращает ответ. Правильной цепочки заранее нет — важно, чтобы ответ был верным на всех проверках.</p>
            </div>
            <div class="guide-route" aria-hidden="true"><span>Вход</span><i></i><span>Твоя схема</span><i></i><span>Ответ</span></div>
        </div>
    </section>
</div>

@code {
    private static RenderFragment Icon(string name) => name switch
    {
        "wire" => @<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h4c4 0 4 10 8 10h4" /><circle cx="4" cy="7" r="1.6" /><circle cx="20" cy="17" r="1.6" /></svg>,
        _ => @<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.2 4.2L19 7" /></svg>
    };
}
