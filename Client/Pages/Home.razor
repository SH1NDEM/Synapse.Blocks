@page "/game"
@using Synapse.Blocks.Graph
@using Synapse.Blocks.Graph.Nodes
@inject LevelStore LevelStore
@inject ProgressStore ProgressStore
@inject SolutionStore SolutionStore
@inject BlockLibraryStore Library
@inject GraphRunner Runner
@inject NodeRegistry Registry
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(Sandbox ? "Песочница — Синапс" : "Игра — Синапс")</PageTitle>

@if (_loading)
{
    <div class="page-loading"><span></span><p>Загружаю уровни…</p></div>
}
else if (_loadError.Length > 0)
{
    <section class="empty-state"><h1>Не удалось загрузить игру</h1><p role="alert">@_loadError</p><button type="button" class="save-button" @onclick="OnInitializedAsync">Повторить</button></section>
}
else if (ActiveLevel is not { } level)
{
    <section class="empty-state">
        <h1>Уровней пока нет</h1>
        <p>Попросите разработчика добавить первое задание в кампанию.</p>
        <a class="primary-link" href="">На главную</a>
    </section>
}
else
{
    @if (Sandbox)
    {
        @* В песочнице (раздел админки) своей шапки нет — панель остаётся над полем. *@
        <section class="game-toolbar sandbox-toolbar">
            <div>
                <small>ПЕСОЧНИЦА / УРОВЕНЬ</small>
                @LevelPicker(level)
            </div>
            <div class="toolbar-stats">
                <span><b>@level.Tests.Count</b> тестов</span>
                <span class="sandbox-mode">без зачёта</span>
                <button type="button" @onclick="ExportSandboxJson">Скачать JSON</button>
                <button type="button" @onclick="ClearProgram">Очистить поле</button>
            </div>
        </section>
    }
    else
    {
        <SectionContent SectionName="header-tools">
            @LevelPicker(level)
            @if (level.IntroSteps.Count > 0)
            {
                <button type="button" class="header-tool" @onclick="ShowLevelIntro">Пояснение</button>
            }
            <button type="button" class="header-tool" @onclick="ClearProgram">Очистить поле</button>
        </SectionContent>
    }

    <div class="game-layout @(Sandbox ? "sandbox-layout" : "child-game-layout")">
        <aside class="mission-pane @(Sandbox ? "sandbox-settings" : "") @Highlight(IntroHighlightTarget.Mission)">
            <div class="mission-scroll">
                @if (EditingBlock is { } editing)
                {
                    <CustomBlockEditor Block="editing"
                                       Root="_program"
                                       OnChanged="BlockStructureChanged"
                                       OnClose="CloseBlock"
                                       OnDelete="() => DeleteBlock(editing)"
                                       OnSaveToLibrary="() => SaveToLibrary(editing)" />
                }
                else if (Sandbox)
                {
                    <span class="direction-pill">НАСТРОЙКА</span>
                    <h1>Тесты программы</h1>
                    <p class="mission-description">Задайте вход и ожидаемый результат. Каждый тест запустит одну и ту же схему с новыми данными.</p>

                    <div class="sandbox-test-list">
                        @foreach (var test in level.Tests)
                        {
                            <article class="sandbox-test-card" @key="test.Id">
                                <div class="sandbox-test-card-head">
                                    <input value="@test.Name" @oninput="e => test.Name = e.Value?.ToString() ?? string.Empty" aria-label="Название теста" />
                                    <button type="button" @onclick="() => RemoveSandboxTest(test.Id)" disabled="@(level.Tests.Count <= 1)" aria-label="Удалить тест">×</button>
                                </div>
                                <label><span>Вход</span><input value="@test.Input" @oninput="e => ChangeSandboxTest(test, e.Value, expected: false)" /></label>
                                <label><span>Ожидаемый выход</span><input value="@test.ExpectedOutput" @oninput="e => ChangeSandboxTest(test, e.Value, expected: true)" /></label>
                            </article>
                        }
                    </div>
                    <button type="button" class="sandbox-add-test" @onclick="AddSandboxTest">+ Добавить тест</button>
                    <p class="sandbox-note">Все блоки доступны без ограничений. Изменения тестов действуют только до перезагрузки страницы.</p>
                }
                else
                {
                    <span class="direction-pill">@level.Direction</span>
                    <p class="operation-number">ОПЕРАЦИЯ @level.Order.ToString("00")</p>
                    <h1>@level.Title</h1>

                    <div class="objective-card @Highlight(IntroHighlightTarget.Objective)">
                        <small>ЦЕЛЬ</small>
                        <strong>@level.Objective</strong>
                    </div>

                    <button type="button" class="mission-description-button @Highlight(IntroHighlightTarget.Description)" @onclick="() => _showDescription = true"><AdminIcon Name="levels" /><span>Описание</span><AdminIcon Name="arrow" /></button>

                    @if (level.Rules.Count > 0)
                    {
                        <div class="solution-rules">
                            <small>УСЛОВИЯ СХЕМЫ</small>
                            @foreach (var rule in _ruleResults)
                            {
                                <span class="@(rule.Passed ? "rule-passed" : "")">@(rule.Passed ? "✓" : "○") @rule.Description</span>
                            }
                        </div>
                    }
                }
            </div>

            @* Запуск и пошаговая проверка — внизу левой панели, под заданием. *@
            <div class="run-panel @Highlight(IntroHighlightTarget.RunPanel)">
                @if (_issues.Count > 0)
                {
                    <div class="graph-issues"><strong>Схема не готова</strong>@foreach (var issue in _issues.Take(4)) { <span>@issue</span> }</div>
                }
                else if (_warnings.Count > 0)
                {
                    <div class="graph-issues graph-warnings"><strong>Обратите внимание</strong>@foreach (var warning in _warnings.Take(3)) { <span>@warning</span> }</div>
                }
                <div class="run-actions">
                    <button type="button" class="run-button" @onclick="RunTests" disabled="@(level.Tests.Count == 0 || _running)">
                        <span>@(_running ? "Выполняю программу…" : $"Запустить все тесты · {level.Tests.Count}")</span><b>@(_running ? "●" : "▶")</b>
                    </button>
                    @if (_running)
                    {
                        <button type="button" class="stop-button" @onclick="StopTests"><span>Остановить</span><b>■</b></button>
                    }
                </div>

                <section class="step-panel @(_stepPanelOpen ? "open" : "")">
                    <button type="button" class="step-panel-toggle" aria-expanded="@_stepPanelOpen" @onclick="() => _stepPanelOpen = !_stepPanelOpen">
                        <span>ПО ШАГАМ</span><small>@DebugStepLabel</small><i aria-hidden="true">@(_stepPanelOpen ? "▾" : "▸")</i>
                    </button>
                    @if (_stepPanelOpen)
                    {
                        if (Sandbox || _running || _results.Count > 0 || _debugSteps.Count > 0)
                        {
                            <section class="debug-readout" aria-label="Текущее состояние программы">
                                <header><span>@(_activeTestCount > 0 ? $"ТЕСТ {_activeTestIndex}/{_activeTestCount}" : "СОСТОЯНИЕ")</span><b>@DebugStepLabel</b></header>
                                @if (_activeTestName.Length > 0)
                                {
                                    <div class="active-test-row"><span>@(_activeTestHidden ? "СКРЫТЫЙ" : "ТЕСТ")</span><code>@_activeTestName</code></div>
                                }
                                <div><span>Вход</span><code>@TestResultText.Display(_debugInput)</code></div>
                                <div><span>Блок</span><code>@_debugNode</code></div>
                                <div class="expected-row"><span>Ожидается</span><code>@TestResultText.Display(_debugExpected)</code></div>
                                <p title="@_debugMessage">@_debugMessage</p>
                            </section>
                        }
                        <div class="step-controls">
                            <button type="button" class="step-button" @onclick="StepDebug" disabled="@(!CanStepProgram)">@StepButtonLabel</button>
                            <button type="button" @onclick="ContinueDebug" disabled="@(!CanStepProgram || _stepPlaying)">Продолжить</button>
                            <button type="button" @onclick="RestartStepDebug" disabled="@(level.Tests.Count == 0 || _running)">Заново</button>
                        </div>
                    }
                </section>
            </div>
        </aside>

        <section class="workspace-pane @Highlight(IntroHighlightTarget.Workspace)">
            <GraphCanvas @ref="_canvas"
                         Program="EditedProgram"
                         Registry="EditRegistry"
                         Run="_run"
                         Revision="_revision"
                         DraggedType="@_dragType"
                         HeadStart="@(EditingBlock is not null ? BlockCrumbs : null)"
                         OnChanged="ProgramChanged"
                         OnInteract="CancelExecutionVisuals"
                         OnHelp="definition => _help = definition"
                         OnOpenBlock="OpenBlock"
                         OnDropped="() => _dragType = null" />
            <TestConsole Level="level" Results="_results" Running="_running" ActiveIndex="_activeTestIndex" ActiveCount="_activeTestCount" CssClass="@Highlight(IntroHighlightTarget.Tests)" />
        </section>

        <aside class="library-pane">
            <div class="library-head"><span>БЛОКИ</span><small>Перетащите на поле или нажмите</small></div>
            <NodePalette Nodes="AvailableNodes"
                         CssClass="@Highlight(IntroHighlightTarget.BlockLibrary)"
                         Variables="@(ShowVariables ? VariablesTab : null)"
                         VariableCount="EditedProgram.Variables.Count"
                         CustomHeader="CustomBlocksHeader"
                         OnAdd="AddFromPalette"
                         OnDragStart="definition => _dragType = definition.TypeId"
                         OnHelp="definition => _help = definition" />

        </aside>
    </div>

    @if (!Sandbox && _showDescription)
    {
        <LevelDescriptionDialog Title="@level.Title" Markdown="@level.Description" OnClose="() => _showDescription = false" />
    }

    @if (!Sandbox && _introStepIndex is int introIndex && introIndex < level.IntroSteps.Count)
    {
        <LevelIntroDialog Level="level" StepIndex="introIndex" OnPrevious="PreviousIntroStep" OnNext="NextIntroStep" OnClose="CloseLevelIntro" />
    }

    @if (!Sandbox && _showSuccess)
    {
        <div class="level-complete-backdrop" role="presentation">
            <section class="level-complete-modal" role="dialog" aria-modal="true" aria-labelledby="complete-title">
                <div class="complete-signal"><i></i><i></i><i></i></div>
                <small>@level.Title</small>
                <h2 id="complete-title">Уровень пройден</h2>
                <div class="complete-stats"><span><b>@_results.Count</b> тестов пройдено</span><span><b>@_program.Nodes.Count</b> блоков в решении</span></div>
                <div class="complete-actions">
                    <button type="button" class="secondary" @onclick="() => _showSuccess = false">Посмотреть схему</button>
                    <button type="button" class="primary" @onclick="GoToNextLevel">@(HasNextLevel ? "Следующий уровень →" : "На главную →")</button>
                </div>
            </section>
        </div>
    }

    @if (_help is { } help)
    {
        <NodeHelpDialog Definition="help" OnClose="() => _help = null" />
    }
}

@code {
    [SupplyParameterFromQuery(Name = "level")]
    public Guid? RequestedLevel { get; set; }

    [Parameter] public bool Sandbox { get; set; }

    // Схема существует независимо от уровня: уровень задаёт только доступные блоки, правила и тесты.
    private readonly GraphProgram _program = new();
    // Реестр основной программы: встроенные блоки и свои блоки игрока. Пересобирается, когда меняются свои блоки.
    private NodeRegistry _registry = NodeRegistry.Default;
    // Свой блок, чья схема сейчас открыта на поле; null — основная программа.
    private string? _editingBlockId;
    private List<GraphCustomBlock> _library = [];
    private readonly GraphRunView _run = new();
    private GraphCanvas? _canvas;
    private List<LevelDefinition> _levels = [];
    private List<GraphTestResult> _results = [];
    private HashSet<Guid> _completed = [];
    private Guid? _activeLevelId;
    private string? _dragType;
    private NodeDefinition? _help;
    private int? _introStepIndex;
    private bool _loading = true;
    private string _loadError = "";
    private bool _showSuccess;
    private bool _showDescription;
    // Блок пошаговой проверки в правой панели свёрнут по умолчанию и раскрывается по кнопке «По шагам».
    private bool _stepPanelOpen;

    // Запуск и пошаговая отладка.
    private bool _running;
    private bool _stepPlaying;
    private bool _debugging;
    private bool _stepSessionFinished;
    private List<GraphStep> _debugSteps = [];
    private int _debugStepIndex = -1;
    private bool _debugMasked;
    private string _debugInput = "—";
    private string _debugExpected = "—";
    private string _debugNode = "—";
    private string _debugMessage = "Ожидает запуска";
    private string _debugFinalError = "";
    private Guid? _debugErrorNode;
    private int _activeTestIndex;
    private int _activeTestCount;
    private string _activeTestName = "";
    private bool _activeTestHidden;
    private int _executionGeneration;
    private int _saveGeneration;

    private List<string> _issues = [];
    private IReadOnlyList<GraphRuleResult> _ruleResults = [];
    // Растёт при каждом изменении программы — по нему поле понимает, что пора перерисоваться.
    private int _revision;
    private (int Revision, IReadOnlyList<NodeDefinition> Nodes)? _availableCache;
    private List<string> _warnings = [];

    private LevelDefinition? ActiveLevel => _levels.FirstOrDefault(level => level.Id == _activeLevelId) ?? _levels.FirstOrDefault();
    private bool HasNextLevel => ActiveLevel is not null && _levels.IndexOf(ActiveLevel) < _levels.Count - 1;

    private GraphCustomBlock? EditingBlock => _program.FindBlock(_editingBlockId);

    /// <summary>Схема на поле: основная программа или схема открытого своего блока.</summary>
    private GraphProgram EditedProgram => EditingBlock?.Body ?? _program;

    private NodeRegistry EditRegistry => EditingBlock is { } block && _registry.CustomScope is { } scope
        ? scope.BodyRegistry(block)
        : _registry;

    private IReadOnlyList<NodeDefinition> AvailableNodes
    {
        get
        {
            // Список нужен несколько раз за перерисовку, а меняется только вместе с программой.
            if (_availableCache is { } cache && cache.Revision == _revision)
                return cache.Nodes;
            var registry = EditRegistry;
            var nodes = Sandbox || ActiveLevel is null ? registry.All : LevelNodes.Available(ActiveLevel, registry);
            // Внутри блока нельзя поставить его самого и блоки, которые его используют.
            if (EditingBlock is { } block && registry.CustomScope is { } scope)
                nodes = nodes.Where(definition => definition is not CustomNodeDefinition custom || !scope.DependsOn(custom.Block, block));
            var list = nodes.ToList();
            _availableCache = (_revision, list);
            return list;
        }
    }

    /// <summary>Путь в шапке поля, пока открыта схема своего блока.</summary>
    private RenderFragment BlockCrumbs => @<nav class="canvas-crumbs" aria-label="Открытая схема">
        <button type="button" @onclick="CloseBlock">← Программа</button><span class="crumb-sep" aria-hidden="true">›</span><b><em aria-hidden="true"></em>@EditingBlock?.Name</b>
    </nav>;

    /// <summary>Шапка вкладки «Мои блоки»: создание блока и личная библиотека.</summary>
    private RenderFragment CustomBlocksHeader => @<div class="custom-blocks-head">
        <button type="button" class="custom-create" @onclick="CreateBlock">+ Новый блок</button>
        <p>Соберите схему один раз и ставьте её как обычный чип. Чтобы изменить блок, дважды щёлкните по его названию на поле.</p>
        @if (_library.Count > 0)
        {
            <details class="block-library-list">
                <summary>Библиотека · @_library.Count</summary>
                @foreach (var item in _library)
                {
                    var saved = item;
                    var inProgram = _program.FindBlock(saved.Id) is not null;
                    <div class="library-item">
                        <span><b>@saved.Name</b><small>@saved.Inputs.Count → @saved.Outputs.Count</small></span>
                        <button type="button" disabled="@inProgram" @onclick="() => ImportBlock(saved)">@(inProgram ? "в схеме" : "добавить")</button>
                        <button type="button" class="library-remove" @onclick="() => RemoveFromLibrary(saved.Id)" aria-label="Убрать из библиотеки">×</button>
                    </div>
                }
            </details>
        }
    </div>;

    /// <summary>Выбор задания: в шапке сайта в игре и над полем в песочнице.</summary>
    private RenderFragment LevelPicker(LevelDefinition level) => @<select class="level-picker" value="@level.Id" @onchange="SelectLevel" aria-label="Задание">
        @foreach (var group in _levels.GroupBy(item => item.Training).OrderByDescending(group => group.Key))
        {
            <optgroup label="@(group.Key ? "Обучение" : _levels.Any(other => other.Training) ? "Усложнённые задания" : "Задания")">
                @foreach (var item in group)
                {
                    <option value="@item.Id">@(_completed.Contains(item.Id) ? "✓" : "○") @item.Order.ToString("00") · @item.Title</option>
                }
            </optgroup>
        }
    </select>;

    // Вкладка «Переменные» в боковой панели.
    private RenderFragment VariablesTab => @<VariablesPanel Program="EditedProgram" Registry="EditRegistry" Run="_run" OnChanged="ProgramChanged" />;

    private bool ShowVariables => EditedProgram.Variables.Count > 0 || AvailableNodes.Any(node => node.Category == NodeCategories.Memory);

    private bool CanStepProgram => ActiveLevel is { Tests.Count: > 0 } && !_running && !_stepSessionFinished;
    private string StepButtonLabel => _stepSessionFinished
        ? (string.IsNullOrWhiteSpace(_debugFinalError) ? "Тест завершён" : "Ошибка в блоке")
        : (_debugging ? "Следующий блок →" : "Выполнить один блок →");
    private string DebugStepLabel => _debugSteps.Count == 0 ? "—" : $"{Math.Max(0, _debugStepIndex + 1)}/{_debugSteps.Count}";

    // ───────────── Загрузка ─────────────

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _loadError = "";
        try
        {
            _levels = await LevelStore.LoadGameAsync();
            if (Sandbox)
                _levels = _levels.Select(CloneForSandbox).ToList();
            _completed = await ProgressStore.LoadAsync();
            _library = await Library.LoadAsync();
            _activeLevelId = RequestedLevel is Guid requested && _levels.Any(level => level.Id == requested)
                ? requested
                : _levels.FirstOrDefault(level => !_completed.Contains(level.Id))?.Id ?? _levels.FirstOrDefault()?.Id;
            _loading = false;
            await LoadSolutionAsync();
            if (!Sandbox)
                ShowLevelIntro();
        }
        catch { _loadError = "Не удалось связаться с сервером. Проверьте подключение и повторите загрузку."; }
        finally { _loading = false; }
    }

    private static LevelDefinition CloneForSandbox(LevelDefinition source)
    {
        var copy = LevelDrafts.Snapshot([source])[0];
        copy.IntroSteps = [];
        foreach (var test in copy.Tests)
        {
            test.Id = Guid.NewGuid();
            test.Hidden = false;
        }
        return copy;
    }

    private async Task SelectLevel(ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var id)) return;
        _showDescription = false;
        _showSuccess = false;
        _activeLevelId = id;
        await LoadSolutionAsync();
        if (!Sandbox)
            ShowLevelIntro();
    }

    private async Task LoadSolutionAsync()
    {
        var saved = Sandbox || ActiveLevel is null ? null : await SolutionStore.LoadAsync(ActiveLevel.Id);
        ReplaceProgram(saved);
        ResetExecution(persist: false);
        _canvas?.Refresh();
    }

    /// <summary>Подставляет сохранённую программу или стартовую: «Вход» и «Выход» уже стоят на поле и соединены порядком.</summary>
    private void ReplaceProgram(GraphProgram? source, bool keepBlocks = false)
    {
        _editingBlockId = null;
        _program.Nodes.Clear();
        _program.Links.Clear();
        _program.Variables.Clear();
        if (!keepBlocks)
            _program.CustomBlocks.Clear();
        FillProgram(source);
        RebuildBlocks();
    }

    private void FillProgram(GraphProgram? source)
    {
        if (source is not null && source.Nodes.Count > 0)
        {
            _program.CustomBlocks.Clear();
            _program.CustomBlocks.AddRange(source.CustomBlocks);
            // Чипы стоят по сетке платы: старые координаты округляем до узлов.
            foreach (var node in source.Nodes)
            {
                node.X = NodeLayout.Snap(node.X);
                node.Y = NodeLayout.Snap(node.Y);
            }
            _program.Nodes.AddRange(source.Nodes);
            _program.Links.AddRange(source.Links);
            _program.Variables.AddRange(source.Variables);
            return;
        }
        // Белый провод порядка «Вход → Выход» уже проложен: игроку остаётся провести данные.
        // Новый провод из «Входа» к другому чипу просто заменит этот.
        var start = new GraphNode { Type = StartNode.Id, X = NodeLayout.Snap(GraphCanvas.OriginX + 40), Y = NodeLayout.Snap(GraphCanvas.OriginY + 80) };
        var output = new GraphNode { Type = OutputNode.Id, X = NodeLayout.Snap(GraphCanvas.OriginX + 520), Y = NodeLayout.Snap(GraphCanvas.OriginY + 80) };
        _program.Nodes.Add(start);
        _program.Nodes.Add(output);
        _program.Links.Add(new GraphLink { FromNode = start.Id, FromPort = "next", ToNode = output.Id, ToPort = "in" });
    }

    private async Task PersistProgramAsync(int generation)
    {
        await Task.Delay(250);
        if (generation != _saveGeneration || Sandbox || ActiveLevel is null || _loading) return;
        await SolutionStore.SaveAsync(ActiveLevel.Id, _program);
    }

    // ───────────── Правка программы ─────────────

    private async Task AddFromPalette(NodeDefinition definition)
    {
        if (_canvas is not null)
            await _canvas.AddNode(definition.TypeId);
    }

    private void ProgramChanged() => ResetExecution();

    private void ClearProgram()
    {
        if (EditingBlock is { } block)
        {
            // В открытом блоке очищается только его схема: остаются «Параметры» → «Вернуть».
            var fresh = CustomBlocks.Create(block.Name, NodeLayout.Snap(GraphCanvas.OriginX + 40), NodeLayout.Snap(GraphCanvas.OriginY + 80));
            block.Body.Nodes.Clear();
            block.Body.Links.Clear();
            block.Body.Variables.Clear();
            block.Body.Nodes.AddRange(fresh.Body.Nodes);
            block.Body.Links.AddRange(fresh.Body.Links.Where(link => link.FromPort == "next"));
        }
        else
        {
            // Свои блоки остаются в палитре: очищается только основная схема.
            ReplaceProgram(null, keepBlocks: true);
        }
        ResetExecution();
        _canvas?.Refresh();
    }

    // ───────────── Свои блоки ─────────────

    private void RebuildBlocks()
    {
        _registry = CustomBlocks.Build(_program, Registry);
        if (_editingBlockId is not null && EditingBlock is null)
            _editingBlockId = null;
    }

    private void OpenBlock(string blockId)
    {
        if (_program.FindBlock(blockId) is null) return;
        _editingBlockId = blockId;
        _help = null;
        ResetExecution(persist: false);
    }

    private void CloseBlock()
    {
        _editingBlockId = null;
        ResetExecution(persist: false);
    }

    private void CreateBlock()
    {
        var number = 1;
        while (_program.CustomBlocks.Any(block => block.Name == $"Блок {number}")) number++;
        var created = CustomBlocks.Create($"Блок {number}", NodeLayout.Snap(GraphCanvas.OriginX + 40), NodeLayout.Snap(GraphCanvas.OriginY + 80));
        _program.CustomBlocks.Add(created);
        RebuildBlocks();
        _editingBlockId = created.Id;
        ResetExecution();
    }

    private void BlockStructureChanged()
    {
        RebuildBlocks();
        ResetExecution();
    }

    private void DeleteBlock(GraphCustomBlock block)
    {
        CustomBlocks.RemoveBlock(_program, block);
        _editingBlockId = null;
        RebuildBlocks();
        ResetExecution();
        _canvas?.Refresh();
    }

    private async Task SaveToLibrary(GraphCustomBlock block)
    {
        _library = await Library.SaveAsync(block);
        // Вместе с блоком сохраняются и блоки, которые стоят внутри него.
        if (_registry.CustomScope is { } scope)
            foreach (var used in _program.CustomBlocks.Where(item => item != block && scope.DependsOn(block, item)))
                _library = await Library.SaveAsync(used);
    }

    private async Task RemoveFromLibrary(string id) => _library = await Library.RemoveAsync(id);

    /// <summary>Добавляет копию блока из библиотеки, а заодно — блоки, которые использует его схема.</summary>
    private void ImportBlock(GraphCustomBlock saved)
    {
        var queue = new Queue<GraphCustomBlock>([saved]);
        while (queue.TryDequeue(out var item))
        {
            if (_program.FindBlock(item.Id) is not null) continue;
            _program.CustomBlocks.Add(GraphJson.Clone(item));
            foreach (var type in item.Body.Nodes.Select(node => node.Type).Where(CustomBlocks.IsCustomType))
                if (_library.FirstOrDefault(entry => string.Equals(entry.Id, type, StringComparison.OrdinalIgnoreCase)) is { } dependency)
                    queue.Enqueue(dependency);
        }
        RebuildBlocks();
        ResetExecution();
    }

    private void AddSandboxTest()
    {
        if (!Sandbox || ActiveLevel is null) return;
        ActiveLevel.Tests.Add(new LevelTestCase { Name = $"Тест {ActiveLevel.Tests.Count + 1}", Input = "0", ExpectedOutput = "0" });
        ResetExecution(persist: false);
    }

    private void RemoveSandboxTest(Guid id)
    {
        if (!Sandbox || ActiveLevel is null || ActiveLevel.Tests.Count <= 1) return;
        ActiveLevel.Tests.RemoveAll(test => test.Id == id);
        ResetExecution(persist: false);
    }

    private void ChangeSandboxTest(LevelTestCase test, object? value, bool expected)
    {
        if (expected) test.ExpectedOutput = value?.ToString() ?? "";
        else test.Input = value?.ToString() ?? "";
        ResetExecution(persist: false);
    }

    private async Task ExportSandboxJson()
    {
        if (!Sandbox) return;
        var json = await LevelStore.ExportAsync(_levels);
        await JS.InvokeVoidAsync("synapseDownloadText", "synapse-sandbox-levels.json", json);
    }

    // ───────────── Проверки схемы ─────────────

    private void Validate()
    {
        _issues = [];
        _warnings = [];
        _ruleResults = Sandbox || ActiveLevel is not { } ruleLevel ? [] : GraphRules.Check(_program, ruleLevel.Rules, _registry);
        foreach (var issue in GraphValidator.Validate(_program, _registry))
            (issue.Severity == IssueSeverity.Error ? _issues : _warnings).Add(issue.Message);

        // Открытый блок, который ещё нигде не стоит, проверяется отдельно — его замечания не мешают запуску.
        if (EditingBlock is { } editing && _registry.CustomScope is { } editScope && !editScope.UsedBy(_program).Contains(editing))
            _warnings.AddRange(GraphValidator.ValidateBlock(editing, editScope).Select(issue => issue.Message));

        if (Sandbox || ActiveLevel is not { } level) return;

        void CheckAllowed(GraphProgram program, NodeRegistry registry, string prefix)
        {
            foreach (var node in program.Nodes)
                if (registry.TryGet(node.Type, out var definition) && !LevelNodes.Allows(level, definition))
                    _issues.Add($"{prefix}Блок «{definition.Label}» недоступен в этом задании.");
        }
        CheckAllowed(_program, _registry, "");
        if (_registry.CustomScope is { } scope)
            foreach (var block in _program.CustomBlocks)
                CheckAllowed(block.Body, scope.BodyRegistry(block), $"«{block.Name}»: ");

        foreach (var rule in _ruleResults.Where(rule => !rule.Passed))
            _issues.Add($"Условие задания: {rule.Description}.");

        _issues = _issues.Distinct().ToList();
        _warnings = _warnings.Distinct().ToList();
    }

    // ───────────── Состояние запуска ─────────────

    private void ResetExecution(bool persist = true)
    {
        _revision++;
        _executionGeneration++;
        _running = false;
        _stepPlaying = false;
        _results = [];
        _run.Clear();
        _debugSteps = [];
        _debugStepIndex = -1;
        _debugging = false;
        _stepSessionFinished = false;
        _debugMasked = false;
        _debugInput = "—";
        _debugExpected = "—";
        _debugNode = "—";
        _debugMessage = "Ожидает запуска";
        _debugFinalError = "";
        _debugErrorNode = null;
        _activeTestIndex = 0;
        _activeTestCount = 0;
        _activeTestName = "";
        _activeTestHidden = false;
        Validate();
        if (persist && !Sandbox && !_loading)
        {
            var generation = ++_saveGeneration;
            _ = PersistProgramAsync(generation);
        }
    }

    private void CancelExecutionVisuals()
    {
        if (_running || _results.Count > 0 || _debugSteps.Count > 0 || _stepSessionFinished || !_run.IsEmpty)
            ResetExecution(persist: false);
    }

    private string NodeLabel(Guid nodeId)
        => _program.FindNode(nodeId) is { } node && _registry.TryGet(node.Type, out var definition) ? definition.Label : "—";

    /// <summary>Блок, на котором программа ошиблась или вернула неверный ответ.</summary>
    private static Guid? FailedNode(GraphExecution execution) => execution.ErrorNodeId ?? (execution.Visited.Count > 0 ? execution.Visited[^1] : null);

    private void ShowStep(GraphStep step, bool masked)
    {
        _run.Apply(step, masked);
        _debugNode = NodeLabel(step.NodeId);
        _debugMessage = step.Detail;
    }

    // ───────────── Пошаговая отладка ─────────────

    private bool PrepareStepRun()
    {
        if (!CanStepProgram || ActiveLevel is not { } level) return false;
        // Запуск показывает основную программу, даже если была открыта схема блока.
        _editingBlockId = null;
        var test = level.Tests.FirstOrDefault(item => !item.Hidden) ?? level.Tests[0];
        ResetExecution(persist: false);
        if (_issues.Count > 0)
        {
            _debugMessage = _issues[0];
            _stepSessionFinished = true;
            return false;
        }

        var execution = Runner.Run(_program, test.Input);
        _debugSteps = execution.Steps.ToList();
        _debugFinalError = execution.Error;
        if (execution.Success && !Value.MatchesExpected(execution.Output, test.ExpectedOutput))
            _debugFinalError = $"Получено «{TestResultText.Display(execution.OutputText)}», ожидалось «{TestResultText.Display(test.ExpectedOutput)}»";
        _debugErrorNode = string.IsNullOrWhiteSpace(_debugFinalError) ? null : FailedNode(execution);
        _debugMasked = false;
        _debugInput = test.Input;
        _debugExpected = test.ExpectedOutput;
        _run.Expected = test.ExpectedOutput;
        _activeTestName = test.Name;
        _debugMessage = _debugSteps.Count == 0 ? execution.Error : $"Тест «{test.Name}» запущен по блокам";
        _debugging = _debugSteps.Count > 0;
        _stepSessionFinished = _debugSteps.Count == 0;
        return _debugging;
    }

    private void StepDebug()
    {
        if (!CanStepProgram) return;
        if (_debugSteps.Count == 0 && !PrepareStepRun()) return;
        StepDebugCore();
    }

    private void StepDebugCore()
    {
        if (!_debugging || _debugStepIndex + 1 >= _debugSteps.Count) return;
        var step = _debugSteps[++_debugStepIndex];
        ShowStep(step, _debugMasked);
        if (_debugStepIndex < _debugSteps.Count - 1) return;

        _debugging = false;
        _stepSessionFinished = true;
        _run.Finish();
        _run.ErrorNode = _debugErrorNode;
        _debugMessage = string.IsNullOrWhiteSpace(_debugFinalError)
            ? $"{step.Detail}. Пошаговый запуск завершён."
            : $"{step.Detail}. Ошибка: {_debugFinalError}";
    }

    private async Task ContinueDebug()
    {
        if (!CanStepProgram || _stepPlaying) return;
        if (_debugSteps.Count == 0 && !PrepareStepRun()) return;
        _stepPlaying = true;
        var generation = _executionGeneration;
        while (_debugging && _debugStepIndex + 1 < _debugSteps.Count && generation == _executionGeneration)
        {
            StepDebugCore();
            StateHasChanged();
            await Task.Delay(180);
        }
        _stepPlaying = false;
    }

    private void RestartStepDebug()
    {
        ResetExecution(persist: false);
        if (PrepareStepRun()) StepDebugCore();
    }

    // ───────────── Прогон всех тестов ─────────────

    private async Task RunTests()
    {
        if (ActiveLevel is not { } level || _running) return;
        _editingBlockId = null;
        ResetExecution(persist: false);
        if (_issues.Count > 0)
        {
            _debugMessage = _issues[0];
            _stepSessionFinished = true;
            return;
        }

        var generation = _executionGeneration;
        _running = true;
        _showSuccess = false;
        _activeTestCount = level.Tests.Count;

        // Схема проверяется один раз, все тесты выполняются сразу, а показываются после анимации каждого теста.
        var prepared = Runner.Prepare(_program);
        var executions = level.Tests.Select(test => Runner.Run(prepared, test.Input)).ToList();
        var computed = level.Tests.Select((test, index) => GraphRunner.ToResult(test, executions[index])).ToList();

        for (var testIndex = 0; testIndex < level.Tests.Count; testIndex++)
        {
            if (generation != _executionGeneration) return;
            var test = level.Tests[testIndex];
            var result = computed[testIndex];
            var execution = executions[testIndex];

            _activeTestIndex = testIndex + 1;
            _activeTestHidden = test.Hidden;
            _activeTestName = test.Hidden ? $"Скрытая проверка {_activeTestIndex}" : test.Name;
            _debugMasked = test.Hidden;
            _debugSteps = execution.Steps.Take(80).ToList();
            _debugStepIndex = -1;
            _debugFinalError = execution.Error;
            if (!result.Passed)
            {
                var mismatch = $"Вход «{TestResultText.Display(test.Input)}»: получено «{TestResultText.Display(result.Actual)}», ожидалось «{TestResultText.Display(result.Expected)}»";
                _debugFinalError = string.IsNullOrWhiteSpace(_debugFinalError) ? mismatch : $"{_debugFinalError} {mismatch}";
            }
            _debugInput = test.Hidden ? GraphRunView.Mask : test.Input;
            _debugExpected = test.Hidden ? GraphRunView.Mask : test.ExpectedOutput;
            _debugNode = "—";
            _debugMessage = $"Подготовка теста {_activeTestIndex} из {_activeTestCount}";
            _run.Clear();
            _run.Expected = _debugExpected;
            StateHasChanged();

            await Task.Delay(260);
            if (generation != _executionGeneration) return;

            var stepDelay = Math.Clamp(1300 / Math.Max(1, _debugSteps.Count), 90, 170);
            for (var stepIndex = 0; stepIndex < _debugSteps.Count; stepIndex++)
            {
                if (generation != _executionGeneration) return;
                _debugStepIndex = stepIndex;
                ShowStep(_debugSteps[stepIndex], test.Hidden);
                StateHasChanged();
                await Task.Delay(stepDelay);
            }
            if (generation != _executionGeneration) return;

            _run.Finish();
            if (!result.Passed)
            {
                _run.ErrorNode = FailedNode(execution);
                if (test.Hidden)
                {
                    // После провала скрытая проверка становится учебным примером: данные открываются.
                    _debugInput = test.Input;
                    _debugExpected = test.ExpectedOutput;
                    _run.Expected = test.ExpectedOutput;
                    foreach (var step in _debugSteps)
                        _run.Apply(step, masked: false);
                    _run.Finish();
                }
            }
            _results.Add(result);
            _debugMessage = result.Passed
                ? $"Тест {_activeTestIndex} из {_activeTestCount} пройден"
                : $"Тест {_activeTestIndex} из {_activeTestCount}: {_debugFinalError}";
            StateHasChanged();

            // Короткая пауза, чтобы увидеть результат теста до следующего запуска.
            await Task.Delay(480);
        }

        if (generation != _executionGeneration) return;
        _running = false;
        _stepSessionFinished = true;
        var failed = _results.FirstOrDefault(result => !result.Passed);
        _debugFinalError = failed is null ? "" : TestResultText.Detail(level, failed);
        _debugMessage = failed is null
            ? $"Все {_results.Count} тестов пройдены"
            : $"Прогон завершён: пройдено {_results.Count(result => result.Passed)} из {_results.Count}";
        StateHasChanged();

        if (_results.Count > 0 && failed is null)
        {
            if (!Sandbox)
            {
                _completed.Add(level.Id);
                await ProgressStore.CompleteAsync(level.Id);
            }
            await Task.Delay(560);
            if (generation != _executionGeneration) return;
            _showSuccess = !Sandbox;
        }
    }

    private void StopTests()
    {
        if (!_running && !_stepPlaying) return;
        _executionGeneration++;
        _running = false;
        _stepPlaying = false;
        _debugging = false;
        _stepSessionFinished = true;
        _run.Finish();
        _debugMessage = "Выполнение остановлено";
    }

    // ───────────── Пояснения и переходы ─────────────

    private void ShowLevelIntro() => _introStepIndex = ActiveLevel?.IntroSteps.Count > 0 ? 0 : null;
    private void CloseLevelIntro() => _introStepIndex = null;

    private void PreviousIntroStep()
    {
        if (_introStepIndex is > 0) _introStepIndex--;
    }

    private void NextIntroStep()
    {
        if (ActiveLevel is null || _introStepIndex is not int index) return;
        _introStepIndex = index + 1 < ActiveLevel.IntroSteps.Count ? index + 1 : null;
    }

    private string Highlight(IntroHighlightTarget target)
    {
        if (ActiveLevel is not { } level || _introStepIndex is not int index || index >= level.IntroSteps.Count) return "";
        var active = level.IntroSteps[index].HighlightTarget;
        if (active is IntroHighlightTarget.InputData or IntroHighlightTarget.OutputData)
            active = IntroHighlightTarget.Description;
        return active == target ? "intro-highlighted" : "";
    }

    private async Task GoToNextLevel()
    {
        if (ActiveLevel is null) return;
        var index = _levels.IndexOf(ActiveLevel);
        if (index >= 0 && index < _levels.Count - 1)
        {
            _activeLevelId = _levels[index + 1].Id;
            _showSuccess = false;
            await LoadSolutionAsync();
            if (!Sandbox)
                ShowLevelIntro();
            return;
        }
        Navigation.NavigateTo(Navigation.BaseUri);
    }
}
