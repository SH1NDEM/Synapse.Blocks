<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <!-- Игра не использует локализованные вычисления, поэтому не загружаем крупные ICU-таблицы. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Release-сборка удаляет недостижимый код Blazor и библиотек. -->
    <PublishTrimmed>true</PublishTrimmed>
    <BlazorWebAssemblyEnableLinking>true</BlazorWebAssemblyEnableLinking>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shared/Synapse.Blocks.Shared.csproj" />
  </ItemGroup>

</Project>
