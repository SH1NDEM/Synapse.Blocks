    private void ResetExecution()
    {
        _executionGeneration++;
        _running = false;
        _results = [];
        _activeExecutionNode = null;
        _previousExecutionNode = null;
        _executionErrorNode = null;
        _executedNodes = [];
        _runtimeValues = [];
        _debugSteps = [];
        _debugStepIndex = -1;
        _debugging = false;
        _stepSessionFinished = false;
        _hasDebugExpectation = false;
        _debugInput = "—";
        _debugValue = "—";
        _debugExpected = "—";
        _debugMessage = "Ожидает запуска";
        _debugFinalError = "";
        _activeTestIndex = 0;
        _activeTestCount = 0;
        _activeTestName = "";
        _activeTestHidden = false;
        _stepPlaying = false;
        _graphIssues = ValidateCurrentProgram();
