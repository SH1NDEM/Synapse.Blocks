    private string ConnectionPath(BlockNode from, BlockNode to, BlockConnection edge)
    {
        var x1 = from.X + CanvasOffsetX + NodeWidth;
        var y1 = from.Y + CanvasOffsetY + PortOffset(from.Kind, edge.Port);
        var x2 = to.X + CanvasOffsetX;
        var y2 = to.Y + CanvasOffsetY + NodeHeight(to.Kind) / 2;
        return BezierPath(x1, y1, x2, y2);
    }

    private string VariableReferencePath(BlockNode variable, BlockNode action)
    {
        var x1 = variable.X + CanvasOffsetX + NodeWidth / 2;
        var y1 = variable.Y + CanvasOffsetY + NodeHeight(variable.Kind);
        var x2 = action.X + CanvasOffsetX + NodeWidth / 2;
        var y2 = action.Y + CanvasOffsetY;
        var bend = Math.Max(42, Math.Abs(y2 - y1) * .45);
        return $"M {CanvasNumber(x1)} {CanvasNumber(y1)} C {CanvasNumber(x1)} {CanvasNumber(y1 + bend)}, {CanvasNumber(x2)} {CanvasNumber(y2 - bend)}, {CanvasNumber(x2)} {CanvasNumber(y2)}";
    }

    private sealed record LoopBounds(double X, double Y, double Width, double Height);

    private LoopBounds? LoopGroupBounds(BlockNode loop)
    {
        var start = _program.Connections.LastOrDefault(edge => edge.FromNodeId == loop.Id && edge.Port == OutputPort.Repeat)?.ToNodeId;
        if (start is null) return null;
        var ids = new HashSet<Guid>();
        var queue = new Queue<Guid>();
        queue.Enqueue(start.Value);
        while (queue.TryDequeue(out var id) && ids.Count < 80)
        {
            if (!ids.Add(id)) continue;
            var node = _program.Nodes.FirstOrDefault(item => item.Id == id);
            if (node is null || node.Kind == BlockKind.Output) continue;
            foreach (var next in _program.Connections.Where(edge => edge.FromNodeId == id).Select(edge => edge.ToNodeId))
                queue.Enqueue(next);
        }
        var nodes = _program.Nodes.Where(node => ids.Contains(node.Id)).ToList();
        if (nodes.Count == 0) return null;
        var left = nodes.Min(node => node.X + CanvasOffsetX) - 24;
        var top = nodes.Min(node => node.Y + CanvasOffsetY) - 34;
        var right = nodes.Max(node => node.X + CanvasOffsetX + NodeWidth) + 24;
        var bottom = nodes.Max(node => node.Y + CanvasOffsetY + NodeHeight(node.Kind)) + 24;
        return new(left, top, right - left, bottom - top);
    }

    private static string LoopCountLabel(BlockNode loop) => LoopUsesInput(loop.Config) ? "ПО ВХОДУ" : $"{LoopCountValue(loop.Config)} РАЗ";

    private static string ValueTypeLabel(string raw)
    {
        var value = raw.Trim();
        if (string.IsNullOrEmpty(value)) return "пусто";
        if (bool.TryParse(value, out _)) return "логика";
        if (double.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out _)) return "число";
        try
        {
            return JsonNode.Parse(value) switch
            {
                JsonArray => "список",
                JsonObject => "объект",
                JsonValue json when json.TryGetValue<bool>(out _) => "логика",
                JsonValue json when json.TryGetValue<double>(out _) => "число",
                _ => "текст"
            };
        }
        catch { return "текст"; }
    }

    private bool HasSolutionRules => ActiveLevel is not null
        && (ActiveLevel.RequiredBlocks.Count > 0
            || ActiveLevel.RequiredLoopCount is not null
            || ActiveLevel.RequiredLoopBodyOperationCount is not null
            || ActiveLevel.MaxOperationBlocks is not null);

    private IEnumerable<string> SolutionRuleLabels()
    {
        if (ActiveLevel is null) yield break;
        foreach (var kind in ActiveLevel.RequiredBlocks)
            yield return $"Обязательный блок: {BlockCatalog.Label(kind)}";
        if (ActiveLevel.RequiredLoopCount is int loopCount)
            yield return $"Повторов цикла: {loopCount}";
        if (ActiveLevel.RequiredLoopBodyOperationCount is int bodyOperations)
            yield return $"Операций в теле цикла: {bodyOperations}";
        if (ActiveLevel.MaxOperationBlocks is int maxOperations)
            yield return $"Операций во всей схеме: не больше {maxOperations}";
    }

    private HashSet<Guid> LoopBodyNodeIds(BlockNode loop)
    {
        var result = new HashSet<Guid>();
        var start = _program.Connections.LastOrDefault(edge => edge.FromNodeId == loop.Id && edge.Port == OutputPort.Repeat)?.ToNodeId;
        if (start is null) return result;

        var queue = new Queue<Guid>();
        queue.Enqueue(start.Value);
        while (queue.TryDequeue(out var id) && result.Count < 80)
        {
            if (!result.Add(id)) continue;
            var node = _program.Nodes.FirstOrDefault(item => item.Id == id);
            if (node is null || node.Kind == BlockKind.Output || node.Kind == BlockKind.Loop) continue;
            foreach (var next in _program.Connections.Where(edge => edge.FromNodeId == id).Select(edge => edge.ToNodeId))
                queue.Enqueue(next);
        }
        return result;
    }

    private List<string> ValidateCurrentProgram()
    {
        var issues = Runner.Validate(_program).ToList();
        if (ActiveLevel is null) return issues;

        foreach (var kind in ActiveLevel.RequiredBlocks)
            if (!_program.Nodes.Any(node => node.Kind == kind))
                issues.Add($"В этом задании обязательно используйте блок «{BlockCatalog.Label(kind)}».");

        if (ActiveLevel.MaxOperationBlocks is int maxOperations)
        {
            var operationCount = _program.Nodes.Count(node => node.Kind == BlockKind.Operation);
            if (operationCount > maxOperations)
                issues.Add($"Используйте не больше {maxOperations} блоков «Операция».");
        }

        if (ActiveLevel.RequiredLoopCount is int requiredCount)
        {
            var loops = _program.Nodes.Where(node => node.Kind == BlockKind.Loop).ToList();
            if (loops.Count > 0 && !loops.Any(loop => !LoopUsesInput(loop.Config) && LoopCountValue(loop.Config) == requiredCount.ToString(CultureInfo.InvariantCulture)))
                issues.Add($"Настройте цикл ровно на {requiredCount} повтора.");
        }

        if (ActiveLevel.RequiredLoopBodyOperationCount is int requiredBodyOperations)
        {
            var loops = _program.Nodes.Where(node => node.Kind == BlockKind.Loop).ToList();
            var hasRequiredBody = loops.Any(loop =>
                LoopBodyNodeIds(loop).Count(id => _program.Nodes.Any(node => node.Id == id && node.Kind == BlockKind.Operation)) == requiredBodyOperations);
            if (loops.Count > 0 && !hasRequiredBody)
                issues.Add($"Поместите в тело цикла ровно {requiredBodyOperations} блока «Операция».");
        }
        return issues.Distinct().ToList();
    }

    private string PreviewPath(BlockNode from)
    {
        var x1 = from.X + CanvasOffsetX + NodeWidth;
        var y1 = from.Y + CanvasOffsetY + PortOffset(from.Kind, _connectingPort);
        return BezierPath(x1, y1, _pointerX, _pointerY);
    }

    private static string BezierPath(double x1, double y1, double x2, double y2)
    {
        // Ограниченные управляющие точки не дают короткой связи сделать большой крюк.
        var dx = x2 - x1;
        var dy = y2 - y1;
        if (dx >= 0)
        {
            var pull = Math.Clamp(dx * .42, 8, 120);
            return FormattableString.Invariant($"M {x1} {y1} C {x1 + pull} {y1}, {x2 - pull} {y2}, {x2} {y2}");
        }

        var outward = Math.Clamp(24 + Math.Abs(dy) * .12, 24, 64);
        return FormattableString.Invariant($"M {x1} {y1} C {x1 + outward} {y1}, {x2 - outward} {y2}, {x2} {y2}");
    }

    private void ApplyRuntimeStep(ExecutionStep step, string displayedValue)
    {
        _runtimeValues[step.NodeId] = displayedValue;
        if (string.IsNullOrWhiteSpace(step.VariableName)) return;

        foreach (var plaque in _program.Nodes.Where(node =>
                     node.Kind == BlockKind.Variable
                     && string.Equals(node.VariableName.Trim(), step.VariableName, StringComparison.OrdinalIgnoreCase)))
        {
            _runtimeValues[plaque.Id] = displayedValue == "•••" ? "•••" : step.VariableValue;
        }
    }

    private string ResultClass(Guid nodeId)
    {
        if (_executionErrorNode == nodeId) return "node-error";
        if (_activeExecutionNode == nodeId) return "node-running";
        if (_executedNodes.Contains(nodeId)) return "node-pass";
        return "";
    }

    private string WireExecutionClass(BlockConnection edge)
        => IsWireActive(edge) ? "wire-active" : "";

    private bool IsWireActive(BlockConnection edge)
        => _previousExecutionNode == edge.FromNodeId && _activeExecutionNode == edge.ToNodeId;

    private bool IsHiddenResult(TestRunResult result)
        => ActiveLevel?.Tests.FirstOrDefault(test => test.Id == result.TestId)?.Hidden == true;

    private string ResultTitle(TestRunResult result)
    {
        if (!IsHiddenResult(result)) return result.Name;
        var index = ActiveLevel?.Tests.FindIndex(test => test.Id == result.TestId) ?? -1;
        return $"Скрытая проверка {(index >= 0 ? index + 1 : 0)}";
    }

    private string ResultDetail(TestRunResult result)
    {
        if (IsHiddenResult(result))
        {
            if (result.Passed) return "скрытая проверка пройдена";
            var values = $"вход: {RuntimeDisplay(result.Input)} · ожидалось: {RuntimeDisplay(result.Expected)} · получено: {RuntimeDisplay(result.Actual)}";
            return string.IsNullOrWhiteSpace(result.Error) ? values : $"{result.Error} · {values}";
        }
        if (result.Passed) return $"получено: {result.Actual}";
        return !string.IsNullOrWhiteSpace(result.Error)
            ? result.Error
            : $"ожидалось {result.Expected}, получено {result.Actual}";
    }

    private static string RuntimeDisplay(string value)
        => string.IsNullOrEmpty(value) ? "∅ пусто" : value;

