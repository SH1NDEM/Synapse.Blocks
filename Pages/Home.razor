    private void ZoomIn() => _zoom = Math.Min(1.5, Math.Round((_zoom + .1) * 10) / 10);
    private void ZoomOut() => _zoom = Math.Max(.2, Math.Round((_zoom - .1) * 10) / 10);

    private void ZoomWithWheel(WheelEventArgs args)
    {
        var oldZoom = _zoom;
        var direction = args.DeltaY < 0 ? .1 : -.1;
        var newZoom = Math.Clamp(Math.Round((oldZoom + direction) * 10) / 10, .2, 1.5);
        if (Math.Abs(newZoom - oldZoom) < .001) return;

        _zoom = newZoom;
        _pendingWheelZoom = (args.ClientX, args.ClientY, oldZoom, newZoom);
    }

