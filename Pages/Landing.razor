@page "/"
@implements IAsyncDisposable
@inject LevelStore LevelStore
@inject ProgressStore ProgressStore
@inject CitySceneStore CitySceneStore
@inject IJSRuntime JS

<PageTitle>Синапс — Город Ноль</PageTitle>

@if (_loading)
{
    <div class="page-loading"><span></span><p>Подключаюсь к Городу Ноль…</p></div>
}
else
{
    <main class="signal-home">
        <section class="signal-hero">
            <div class="signal-copy">
                <span class="signal-eyebrow"><i></i> СЕТЬ ГОРОДА НОЛЬ / ONLINE</span>
                <h1>Здесь программы<br /><em>меняют мир.</em></h1>
                <p>Получайте данные, собирайте логику из блоков и возвращайте городу правильный ответ. Каждая рабочая схема оживляет новый сектор.</p>
                <div class="signal-actions">
                    <a class="signal-start" href="game">@(_completed.Count > 0 ? "Продолжить с последней операции" : "Запустить первую операцию") <b>→</b></a>
                    <a class="signal-guide" href="guide">Сначала разобраться</a>
                </div>
                <div class="signal-progress"><span><b style="width:@ProgressPercent%"></b></span><div><strong>@ProgressPercent%</strong><small>сети восстановлено</small></div></div>
            </div>

            <div class="chip-city" aria-label="Город Ноль на системной плате">
                <header>
                    <div><span>ГОРОД НОЛЬ / SYSTEM BOARD</span><strong>Программы внутри города</strong></div>
                    <b>@_completed.Count / @_levels.Count</b>
                </header>

                <div class="chip-city-scene">
                    <canvas id="synapse-city-webgl" class="city-webgl" aria-hidden="true"></canvas>
                    <div class="city-webgl-vignette" aria-hidden="true"></div>

                    @for (var index = 0; index < _levels.Count; index++)
                    {
                        var level = _levels[index];
                        var complete = _completed.Contains(level.Id);
                        <a class="city-system-label @(complete ? "complete" : "")" data-system-index="@index" href="game?level=@level.Id" aria-label="Открыть уровень @level.Title">
                            <strong>@((index + 1).ToString("00"))</strong>
                        </a>
                    }
                    <div class="city-webgl-fallback">3D-сцена недоступна в этом браузере</div>
                </div>

                <aside class="chip-city-status">
                    <div><span>ЭНЕРГИЯ</span><b>@(12 + ProgressPercent / 2)%</b></div>
                    <div><span>СВЯЗЬ</span><b>@(ProgressPercent > 0 ? "СТАБИЛЬНА" : "ЛОКАЛЬНАЯ")</b></div>
                    <p><i></i> Сигналы проходят между программными районами</p>
                </aside>
            </div>
        </section>

        <section class="mission-feed">
            <header><div><small>ДОСТУПНЫЕ ЗАДАНИЯ</small><h2>Выберите следующий сигнал</h2></div><p>Нет единственной правильной схемы. Город проверяет только результат на разных данных.</p></header>
            <div class="mission-feed-grid">
                @foreach (var level in _levels)
                {
                    var complete = _completed.Contains(level.Id);
                    <a class="mission-ticket @(complete ? "complete" : "")" href="game?level=@level.Id">
                        <span>@level.Order.ToString("00")</span><div><small>@level.Direction · @level.Tests.Count проверок</small><h3>@level.Title</h3><p>@level.Objective</p></div><b>@(complete ? "✓" : "→")</b>
                    </a>
                }
            </div>
        </section>
    </main>
}

@code {
    private List<LevelDefinition> _levels = [];
    private HashSet<Guid> _completed = [];
    private bool _loading = true;
    private bool _cityStarted;
    private string _citySceneJson = "";
    private int ProgressPercent => _levels.Count == 0 ? 0 : (int)Math.Round(_completed.Count * 100d / _levels.Count);
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _levels = await LevelStore.LoadGameAsync();
            _completed = await ProgressStore.LoadAsync();
            var cityScene = await CitySceneStore.LoadAsync();
            _citySceneJson = CitySceneStore.Export(CitySceneStore.MatchLevelCount(cityScene, _levels.Count));
        }
        finally
        {
            // Даже повреждённое локальное сохранение не оставляет главную на вечной загрузке.
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _cityStarted) return;
        _cityStarted = await JS.InvokeAsync<bool>("synapseCity3d.start", "synapse-city-webgl", _citySceneJson, false, null);
    }

    public async ValueTask DisposeAsync()
    {
        if (_cityStarted)
            await JS.InvokeVoidAsync("synapseCity3d.stop", "synapse-city-webgl");
    }
}
